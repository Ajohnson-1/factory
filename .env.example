# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
# The board whose Ready list starts work. Required, and used by
# `npm run register:trello-webhooks` as the webhook's idModel.
TRELLO_BOARD_ID=
READY_LIST_ID=
REVIEW_LIST_ID=
DONE_LIST_ID=
# OAuth 1.0 app secret from https://trello.com/apps/admin. Trello signs each
# delivery with it in X-Trello-Webhook (HMAC-SHA1 over body + callback URL), and
# because Trello cannot set custom request headers this is the only credential
# available on that route. Leave it unset and the factory refuses every delivery
# rather than accepting unsigned ones.
TRELLO_APP_SECRET=
# Our own public callback URL, exactly as registered — Trello hashes it into the
# signature, so a trailing slash here that the registration did not use is a
# mismatch on every delivery, not a typo.
TRELLO_WEBHOOK_URL=https://your-vps.example/webhook/trello
# Debug capture: append each inbound delivery's raw body to this file as JSON
# lines. Card titles and descriptions land in it, so pick a host path the agents
# cannot read, and unset it when you are done. Empty disables capture.
# TRELLO_WEBHOOK_DEBUG_FILE=/var/log/factory/trello-deliveries.jsonl

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# Factory
REPO_PATH=/opt/repos/your-repo
WEBHOOK_PORT=8787
CI_TIMEOUT_MS=900000
# Optional: job database (default ./data/factory.db; tests point it at a temp file)
# FACTORY_DB_PATH=/var/lib/factory/factory.db

# Agent runtime (phase 2.1: keep .env away from the agents)
# container = one throwaway Docker container per run. Only the worktree and the
#             provider key below reach it. Requires the `factory-agent` image:
#             bash deploy/docker/build.sh
# process   = run pi inside this process. Dev only: the agent then inherits every
#             secret in this file and can read any file this user can.
# AGENT_RUNTIME=container
# AGENT_IMAGE=factory-agent

# Per-container resource caps. Phase 2.2 runs several agent containers per card
# at once, so these are per container, not per card. Docker accepts e.g. 512m /
# 2g / 1073741824 for memory and fractional cores for cpus. Set AGENT_MEMORY=none
# or AGENT_CPUS=0 to lift a cap.
# AGENT_MEMORY=2g
# AGENT_CPUS=1

# Agent graphs (phase 2.2)
# AGENT_GRAPH=1               0 = one agent per card (the MVP path) instead of an
#                             orchestrator that fans out children.
# MAX_PARALLEL_AGENTS=4       child containers at once per card; excess spawns queue.
# AGENT_TIMEOUT_MS=1200000    wall clock per child (20 min). The container is killed.
# ORCHESTRATOR_TIMEOUT_MS=2700000
#                             ceiling on the planner's own wall clock (45 min).
#                             It is otherwise derived as AGENT_TIMEOUT_MS x
#                             (MAX_AGENT_RUNS + 1) = 260 min at these defaults,
#                             and the worker runs one card at a time: one hung
#                             orchestrator would hold every other card for hours.
#                             Never capped below a single child timeout.
# MAX_AGENT_RUNS=12           child runs per card, so a looping orchestrator has a
#                             cap. Counted PER ATTEMPT: re-triggering a card (a
#                             re-drag to Ready, or /factory retry) starts attempt N
#                             +1 with a fresh budget, so a card that spent 12 runs
#                             failing can still be made to work.
# AGENT_MODEL=                model pattern for children, e.g. "vmlx/pxleng/Swift-...".
# ORCHESTRATOR_MODEL=         override for the long-lived planning session.
#
# How a containerized orchestrator reaches the host to ask for those children.
# FACTORY_IPC_BIND=127.0.0.1   loopback works on Docker Desktop. On a Linux host,
#                              --add-host=host.docker.internal:host-gateway arrives
#                              at the bridge address, so this must be widened to
#                              0.0.0.0 (or the docker0 address) — and then a per-run
#                              token is the only thing gating an endpoint that can
#                              start containers. Keep it loopback unless you need it.
# FACTORY_IPC_ADD_HOST=        --add-host spec for every agent run. EMPTY by
#                              default, which is right on Docker Desktop: that
#                              product already defines host.docker.internal and it
#                              reaches a loopback listener. Docker Engine on Linux
#                              does not define the name AT ALL, so a container
#                              cannot resolve the host no matter how
#                              FACTORY_IPC_BIND is widened — set
#                              `host.docker.internal:host-gateway` there.
#                              deploy/configure-env.sh writes both lines for you on
#                              a Linux host, because they are one requirement.
# FACTORY_IPC_PORT=0           0 = let the OS pick, which concurrent cards need.
# FACTORY_IPC_SLACK_MS=60000   how much longer the in-container tool waits than the
#                              host's own per-child timeout.
# FACTORY_AGENT_MODELS_FILE=   host path to a pi models.json, mounted read-only into
#                              every agent container. Needed to point agents at a
#                              local/openai-compatible model (see models.json for the
#                              vmlx box used in testing). Off by default: the worktree
#                              and the read-only .git are the agent's whole view.
# FACTORY_AGENT_SETTINGS_FILE= host path to a pi settings.json, mounted read-only the
#                              same way. This exists for one key: httpIdleTimeoutMs,
#                              which defaults to 300000 (5 min) and is what
#                              retry.provider.timeoutMs inherits. A slow local model
#                              is therefore cut off inside pi long before
#                              AGENT_TIMEOUT_MS, and it looks like a broken agent.
#                              There is no CLI flag or env var for it; scripts/
#                              graph-smoke.ts writes one matching AGENT_TIMEOUT_MS
#                              when you raise that, so a slow run does not need this
#                              set by hand.

# PR reviewer (phase 2.3)
# A `pull_request` webhook with action opened or synchronized on a factory/*
# branch starts one review: a detached checkout of the PR head, a reviewer
# container with read-only tools, and its findings posted as PR comments through
# the host (GITHUB_TOKEN never enters a container, so the reviewer only ever asks).
# REVIEW_MAX_COMMENTS=20        line comments per review. The summary does not count
#                              against it, and a reviewer that runs out is told to
#                              put the rest in the summary rather than silently
#                              dropped.
# REVIEW_MAX_RUNS_PER_CARD=5    how many distinct heads of a card's PR may be
#                              reviewed, EVER. This cannot be MAX_AGENT_RUNS:
#                              reviews are not graph children and are not counted
#                              in agent_runs, precisely so that pushing a branch
#                              twelve times cannot spend a coder's budget.
# REVIEWER_MODEL=              model for reviews; falls back to AGENT_MODEL. The
#                              usual reason to set it is to review with a cheaper
#                              model than the one that wrote the diff.
# REVIEW_TIMEOUT_MS=           wall clock for one review container; falls back to
#                              AGENT_TIMEOUT_MS. Shorter is usually right — a review
#                              reads a diff, it does not write one.

# LLM provider key(s) for the agents. Only these are passed into the container
# (see src/agent/env.ts) — set just the one you use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
