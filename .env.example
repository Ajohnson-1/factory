# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
READY_LIST_ID=
REVIEW_LIST_ID=
DONE_LIST_ID=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# Factory
REPO_PATH=/opt/repos/your-repo
WEBHOOK_PORT=8787
WEBHOOK_SECRET=
CI_TIMEOUT_MS=900000
# Optional: job database (default ./data/factory.db; tests point it at a temp file)
# FACTORY_DB_PATH=/var/lib/factory/factory.db

# Agent runtime (phase 2.1: keep .env away from the agents)
# container = one throwaway Docker container per run. Only the worktree and the
#             provider key below reach it. Requires the `factory-agent` image:
#             bash deploy/docker/build.sh
# process   = run pi inside this process. Dev only: the agent then inherits every
#             secret in this file and can read any file this user can.
# AGENT_RUNTIME=container
# AGENT_IMAGE=factory-agent

# Per-container resource caps. Phase 2.2 runs several agent containers per card
# at once, so these are per container, not per card. Docker accepts e.g. 512m /
# 2g / 1073741824 for memory and fractional cores for cpus. Set AGENT_MEMORY=none
# or AGENT_CPUS=0 to lift a cap.
# AGENT_MEMORY=2g
# AGENT_CPUS=1

# Agent graphs (phase 2.2)
# AGENT_GRAPH=1               0 = one agent per card (the MVP path) instead of an
#                             orchestrator that fans out children.
# MAX_PARALLEL_AGENTS=4       child containers at once per card; excess spawns queue.
# AGENT_TIMEOUT_MS=1200000    wall clock per child (20 min). The container is killed.
# MAX_AGENT_RUNS=12           child runs per card, so a looping orchestrator has a cap.
# AGENT_MODEL=                model pattern for children, e.g. "vmlx/pxleng/Swift-...".
# ORCHESTRATOR_MODEL=         override for the long-lived planning session.
#
# How a containerized orchestrator reaches the host to ask for those children.
# FACTORY_IPC_BIND=127.0.0.1   loopback works on Docker Desktop. On a Linux host,
#                              --add-host=host.docker.internal:host-gateway arrives
#                              at the bridge address, so this must be widened to
#                              0.0.0.0 (or the docker0 address) — and then a per-run
#                              token is the only thing gating an endpoint that can
#                              start containers. Keep it loopback unless you need it.
# FACTORY_IPC_PORT=0           0 = let the OS pick, which concurrent cards need.
# FACTORY_IPC_SLACK_MS=60000   how much longer the in-container tool waits than the
#                              host's own per-child timeout.
# FACTORY_AGENT_MODELS_FILE=   host path to a pi models.json, mounted read-only into
#                              every agent container. Needed to point agents at a
#                              local/openai-compatible model (see models.json for the
#                              vmlx box used in testing). Off by default: the worktree
#                              and the read-only .git are the agent's whole view.

# LLM provider key(s) for the agents. Only these are passed into the container
# (see src/agent/env.ts) — set just the one you use.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
