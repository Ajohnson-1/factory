# Copy to .env and fill values. This file lives at the FACTORY repo root —
# the daemon/CLI read it via scripts/lib/trello.js (env → .env fallback), and
# the discord-bot worktree bootstrap copies it into worktrees for bot work.

# --- trello software factory (docs/factory.md) ---
# Key: https://trello.com/account ("API Key" -> SHOW); token via the authorize
# link on the same page. Scope needed: read, write.
TRELLO_KEY=
TRELLO_TOKEN=
# Board short link; defaults to ZHkVYBN1 (https://trello.com/b/ZHkVYBN1/discord-bot)
# TRELLO_BOARD=ZHkVYBN1

# --- repo registry (config/factory-repos.json; docs/factory-migration.md §4.1) ---
# Committed file = laptop defaults. Machine-local override: point this at a
# different JSON (on the Proxmox box: /opt/factory/config/factory-repos.local.json).
# FACTORY_REPOS_FILE=

# --- daemon (scripts/factory-daemon.js; launchd label com.ajohnson.factory-daemon) ---
# RUNTIME RULE (docs/factory-migration.md D8): the daemon must run from exactly
# ONE repo checkout at a time — never both the discord-bot and factory copies.
# Concurrent card runs (daemon cap). Read from the daemon PROCESS env at
# startup — set it in the daemon environment and restart the daemon to apply.
# Default 1 = internal-first canary: the prod-watch window is the canary
# interval between single-in-flight deploys (docs/factory.md "Gradual rollout
# (internal-first)" says when to raise it).
# FACTORY_MAX_PARALLEL=1
# FACTORY_POLL_MS=20000           # Ready-list poll interval
# FACTORY_MAX_TIME=2700           # wall-clock cap per agent run (s)
# FACTORY_MAX_COST=20             # cost cap per agent run (USD)
# FACTORY_CRASH_RETRIES=2         # respawn budget for a crashed stage run
# FACTORY_MODEL=                  # omp model override for dispatched runs
# FACTORY_OMP_BIN=                # path to the omp binary (default: omp on PATH)
# FACTORY_STALL_SILENCE_MS=       # silence before the stall sweep flags a run

# --- factory deploy/verify (docs/factory.md; scripts/deploy.js, verify-deploy.js) ---
# Debian 12 VM from scripts/provision-deploy-host.sh (docs/deploy-host.md).
# REQUIRED for deploy: no sensible default — the VM address is unknown at merge time.
DEPLOY_HOST=
DEPLOY_USER=factory
DEPLOY_KEY=~/.ssh/factory_deploy_ed25519
DEPLOY_DIR=/opt/discord-bot
# Optional overrides (defaults in scripts/deploy.js):
# DEPLOY_REPO=git@github.com:Ajohnson-1/discord-bot.git
# DEPLOY_ACTOR=<name recorded in .deploy-history>

# --- factory ask-human protocol (docs/factory.md "Asking a human") ---
# node scripts/factory.js ask <card> <question|-> → posts [ASK], pings you on
# Discord, blocks until a [HUMAN] comment reply. All optional:
# Bot token used for the DM ping (REST v10); BOT_TOKEN and DISCORD_BOT_TOKEN
# are both accepted (factory-ask precedence: DISCORD_BOT_TOKEN || BOT_TOKEN).
# BOT_TOKEN=
# Owner Discord user id for the ping; default = config/config.json superUserId.
# FACTORY_DISCORD_USER_ID=
# Webhook override: when set, the ping goes here instead of a bot DM.
# FACTORY_DISCORD_WEBHOOK=
# Wait-window defaults (milliseconds) for ask/wait:
# FACTORY_ASK_TIMEOUT_MS=3600000   # block 1 h before {timedOut:true} + exit 1
# FACTORY_ASK_POLL_MS=30000        # card-comment poll interval

# --- factory done-ping (docs/factory.md "Pinging on Done") ---
# node scripts/factory.js done-watch → DMs the owner once per card arriving in
# the Done list (deduped via data/factory-done-ping.json). Reuses
# FACTORY_DISCORD_USER_ID / FACTORY_DISCORD_WEBHOOK / BOT_TOKEN from the
# ask-human section above — no new required vars. Poll interval default
# (falls back to FACTORY_POLL_MS):
# FACTORY_DONE_POLL_MS=15000

# --- factory comment listener (docs/factory.md "Listening for human comments") ---
# The daemon auto-runs the comment-resume watcher: a human comment on an
# in-flight card gets a [RESUME] ack + a scheduler run seeded at the card's
# CURRENT stage (deduped via data/factory-comment-resume.json watermarks).
# factory.js resume-watch is diagnostics only ([--interval ms] [--once]
# [--dry-run]). Poll interval default (falls back to FACTORY_POLL_MS):
# FACTORY_RESUME_POLL_MS=15000
# Auto-resumes per card before the watcher goes silent (loop guard):
# FACTORY_RESUME_MAX=5

# --- factory nightly review sweep (docs/factory.md "Nightly review sweep") ---
# node scripts/factory-sweep.js once → files one date-deduped [SWEEP] review
# card into Ready (the daemon dispatches it; the sweep's findings become
# follow-up [SWEEP-FINDING] Ready cards). Reuses TRELLO_KEY/TRELLO_TOKEN —
# no new required vars. Slice + caps (read at run time by once/dry-run):
# FACTORY_SWEEP_DAYS=7
# FACTORY_SWEEP_MAX_FILES=40    # nightly slice cap; overflow named in the card desc
# FACTORY_SWEEP_MAX_FINDINGS=5  # finding cards per sweep; overflow in [IMPL]
# launchd schedule, baked into the plist at `install` (default 03:15 local):
# FACTORY_SWEEP_HOUR=3
# FACTORY_SWEEP_MINUTE=15

# --- factory metrics (scripts/factory-metrics.js; launchd 6 h cadence) ---
# FACTORY_METRICS_INTERVAL_MS=      # interval override for the launchd timer

# --- prod watcher (scripts/prod-watch.js; launchd 300 s cadence) ---
# Opens [PROD-WATCH] incident cards into Ready when the deployed bot stops
# responding. Reuses TRELLO_KEY/TRELLO_TOKEN; probe settings:
# PROD_WATCH_HOSTNAME=
# PROD_WATCH_INTERVAL_MS=
# PROD_WATCH_SUBNET=
