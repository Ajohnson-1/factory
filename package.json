{
  "name": "factory",
  "version": "0.1.0",
  "description": "Software factory managed via Discord + Trello, powered by pi coding agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.extension.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "tsx scripts/dry-run.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "test:graph-smoke": "tsx scripts/graph-smoke.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@octokit/rest": "^21.0.0",
    "better-sqlite3": "^11.0.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
